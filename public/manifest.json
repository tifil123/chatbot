  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+chatbot",
      "url": "/?handler=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "documents",
          "accept": ["text/plain", ".pdf", ".doc", ".docx"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "application/pdf": [".pdf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "permissions": {
    "desktop-notification": {
      "description": "Yeni mesajlar için bildirim gönderme"
    },
    "geolocation": {
      "description": "Konum bazlı servisler için konum erişimi"
    },
    "camera": {
      "description": "Kamera erişimi için"
    },
    "microphone": {
      "description": "Sesli mesajlar için mikrofon erişimi"
    },
    "clipboard-read": {
      "description": "Panodan metin kopyalama için"
    },
    "clipboard-write": {
      "description": "Panoya metin yapıştırma için"
    }
  },
  "optional_permissions": [
    "background-sync",
    "storage",
    "unlimitedStorage"
  ],
  "features": [
    "standalone",
    "fullscreen",
    "minimal-ui"
  ],
  "chromeos": {
    "file_handlers": [
      {
        "action": "/open-file",
        "accept": {
          "text/plain": [".txt"],
          "application/pdf": [".pdf"]
        }
      }
    ]
  },
  "prefer_related_applications": false,
  "generated": "2025-12-11T19:14:00.000Z",
  "version": "2.0.0",
  "author": {
    "name": "Chatbot Development Team",
    "url": "https://github.com/chatbot-team",
    "email": "dev@chatbot.com"
  },
  "homepage": "https://chatbot.example.com",
  "support_url": "https://support.chatbot.example.com",
  "privacy_policy_url": "https://chatbot.example.com/privacy",
  "license_url": "https://chatbot.example.com/license",
  "documentation": "https://docs.chatbot.example.com",
  "repository": {
    "url": "https://github.com/chatbot-team/chatbot",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/chatbot-team/chatbot/issues"
  },
  "release_notes": "https://github.com/chatbot-team/chatbot/releases",
  "manifest_version": 3,
  "offline_enabled": true,
  "cache": {
    "enabled": true,
    "max_age": 86400,
    "strategy": "cache_first"
  },
  "update": {
    "check_interval": 3600,
    "auto_update": true,
    "notification": true
  },
  "analytics": {
    "enabled": true,
    "anonymous": true,
    "tracking_id": "GA-CHATBOT-2.0"
  },
  "experimental_features": {
    "ai_response_suggestions": true,
    "voice_input": true,
    "multilingual_support": true,
    "context_awareness": true
  },
  "accessibility": {
    "screen_reader": true,
    "high_contrast": true,
    "reduced_motion": true,
    "keyboard_navigation": true
  },
  "security": {
    "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com;",
    "integrity": true,
    "sri": true
  },
  "performance": {
    "lazy_loading": true,
    "code_splitting": true,
    "tree_shaking": true,
    "minification": true
  },
  "compatibility": {
    "browsers": [
      "Chrome >= 88",
      "Firefox >= 85",
      "Safari >= 14",
      "Edge >= 88"
    ]
  }
}